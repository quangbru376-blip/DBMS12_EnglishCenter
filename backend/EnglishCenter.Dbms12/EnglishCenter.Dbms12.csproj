<Project Sdk="Microsoft.NET.Sdk.Web">
 <PropertyGroup>
  <TargetFramework>net10.0</TargetFramework><Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings>
  <TreatWarningsAsErrors>true</TreatWarningsAsErrors><EnableNETAnalyzers>true</EnableNETAnalyzers>
  <EnableDefaultContentItems>false</EnableDefaultContentItems><RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
 </PropertyGroup>
 <ItemGroup>
  <PackageReference Include="Microsoft.Data.SqlClient" Version="6.1.1" />
  <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="7.7.1" />
  <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="9.0.4" />
  <PackageReference Include="System.Security.Cryptography.Pkcs" Version="9.0.21" />
  <Content Include="Resources/PasswordBlocklist/**" CopyToOutputDirectory="PreserveNewest" />
  <Content Include="Resources/SqlTransactionsBaseline.json" CopyToOutputDirectory="PreserveNewest" />
  <Content Include="Resources/SqlLayoutBaseline.json" CopyToOutputDirectory="PreserveNewest" />
  <Content Include="../../database/dbms12-compact/**/*.sql" Link="Resources/Dbms12/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  <Content Include="../../database/dbms12-compact/manifest.json" Link="Resources/Dbms12/manifest.json" CopyToOutputDirectory="PreserveNewest" />
 </ItemGroup>
</Project>
