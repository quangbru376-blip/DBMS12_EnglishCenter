        datetime2(3) paid_at  "NULL"
        int paid_by FK "NULL"
        varchar(16) payment_method  "NULL"
        nvarchar(100) payment_reference  "NULL"
        rowversion row_version  "NOT NULL"
    }
    AuditLog {
        bigint audit_id PK "NOT NULL"
        uniqueidentifier operation_id UK "NOT NULL"
