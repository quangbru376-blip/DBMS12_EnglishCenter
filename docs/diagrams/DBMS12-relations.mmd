        datetime2(3) occurred_at  "NOT NULL"
        nvarchar(1000) reason  "NULL"
        nvarchar(4000) change_details  "NOT NULL"
        varchar(45) ip_address  "NULL"
    }
    ReplayOperation {
        bigint replay_id PK "NOT NULL"
        int actor_account_id FK "NOT NULL"
