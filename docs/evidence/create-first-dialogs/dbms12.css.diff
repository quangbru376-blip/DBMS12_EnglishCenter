--- before/dbms12.css

+++ after/dbms12.css

@@ -12,4 +12,6 @@

 .ec12-notice { white-space:pre-wrap;overflow-wrap:anywhere; }
 .ec12-attendance select { min-width:9rem; }
+.ec12-app .ec12-selection { max-width:56rem; }
+.ec12-app .ec12-selection .ec12-list-viewport { max-height:22rem; }
 
 /* Shared content frames for all seven DBMS12 roles. */
@@ -76,4 +78,7 @@

