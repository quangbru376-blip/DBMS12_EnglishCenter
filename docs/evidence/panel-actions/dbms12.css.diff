@@ -80,4 +82,5 @@

   .ec12-app :is(.ec-card,.ec12-filter,.ec12-pagination,.ec12-workspace>.ec-page-header) { padding:var(--ec-space-4); }
   .ec12-app .ec-card>h2 { font-size:var(--ec-text-base); }
