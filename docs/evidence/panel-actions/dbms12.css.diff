-.ec12-top-panels { align-items:start; }
+.ec12-table-header { display:flex; flex-wrap:wrap; align-items:center; justify-content:space-between; gap:var(--ec-space-4); padding-bottom:var(--ec-space-3); border-bottom:1px solid var(--ec-divider); }
+.ec12-table-header>h2 { margin:0; min-width:0; font-size:var(--ec-text-lg); font-weight:600; line-height:1.5; overflow-wrap:anywhere; }
+.ec12-panel-actions { display:flex; flex-wrap:wrap; gap:var(--ec-space-2); margin-inline-start:auto; }
 .ec12-create-panel .ec12-fields { align-items:start; }
